@page "/"
@using PersonalAccountant.Shared
@using System.Linq

<PageTitle>Accountant</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-sm btn-danger" @onclick="() => _showClearAllConfirmation = true">Clear All Data</button>
    </div>

    <div class="card text-white bg-dark mb-4 budget-summary-card" tabindex="-1">
        <div class="card-body text-center">
            <h5 class="card-title">Remaining Budget</h5>
            <h1 class="display-4 fw-bold">₴@((_budget - _totalExpenses).ToString("F2"))</h1>

            @if (_isLoadingCurrency)
            {
                <p class="text-white-50 mb-0"><em>Loading conversion...</em></p>
            }
            else if (_remainingBudgetInEur > 0)
            {
                <p class="text-white-50 mb-0 fs-5">approx. €@_remainingBudgetInEur.ToString("F2")</p>
            }

            <p class="mt-2 mb-0">Budget: ₴@_budget.ToString("F2") | Spent: ₴@_grossSpent.ToString("F2")</p>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-3">
                <button class="btn btn-sm btn-outline-light" @onclick="() => _isEditingBudget = true">Set Budget</button>
                <button class="btn btn-sm btn-outline-success" @onclick="OpenAddIncomeModal">Add Income</button>
            </div>
        </div>
    </div>

    @if (_isDatePickerVisible)
    {
        <div class="d-flex align-items-center mb-3">
            <button class="btn btn-link" @onclick='() => { _isDatePickerVisible = false; _selectedDate = DateTime.Today; }'>
                <span style="font-size: 1.5em;">←</span>
            </button>
            <h3 class="mb-0">Select a Date</h3>
        </div>
        <input type="date" class="form-control mb-3" value="@_selectedDate.ToString("yyyy-MM-dd")"
               @onchange="(e) => { _selectedDate = DateTime.Parse(e.Value.ToString()); _isDatePickerVisible = false; }" />
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="mb-0">Calendar</h3>
            <div>
                <button class="btn btn-primary" @onclick="() => _isDatePickerVisible = true">Date</button>
            </div>
        </div>
        <CalendarStrip @bind-SelectedDate="_selectedDate" />
    }

    <hr />

    <h3 class="mb-3 mt-4">Add Expense</h3>
    <div class="list-group mb-4">
        @foreach (var category in _categoryDisplayInfo.Where(c => c.Key != ExpenseCategory.Income))
        {
            <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-sm btn-link me-2 p-0 category-toggle-btn" @onclick="() => ToggleCategoryExpansion(category.Key)">
                            <span class="fs-5 align-middle">@(_expandedCategory == category.Key ? "▲" : "▼")</span>
                        </button>
                        <span class="fs-5 fw-bold align-middle">@category.Value.Name</span>
                    </div>
                    <div @onclick="() => OpenAddExpenseModal(category.Key)" style="cursor: pointer;">
                        <span class="fs-2">@category.Value.Icon</span>
                    </div>
                </div>

                @if (_expandedCategory == category.Key)
                {
                    <div class="mt-3">
                        @{
                            var categoryExpenses = _expenses
                            .Where(e => e.Category == category.Key && e.Date.Date == _selectedDate.Date)
                            .OrderByDescending(e => e.Date)
                            .ToList();
                        }

                        @if (categoryExpenses.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var expense in categoryExpenses)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center ps-2 border-0">
                                        <div>
                                            @expense.Description<br>
                                            <small class="text-muted">@expense.Date.ToShortDateString()</small>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <button class="btn btn-sm btn-link p-0 me-2 edit-btn" @onclick="() => OpenEditModal(expense)">✏️</button>
                                            <span class="badge bg-secondary rounded-pill">₴@expense.Amount.ToString("F2")</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center p-2 mb-0">No expenses in this category yet.</p>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <h3 class="mb-3">Transactions for @(_selectedDate.Date == DateTime.Today ? "Today" : _selectedDate.ToShortDateString())</h3>
    @if (_expenses == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        var dailyTransactions = _expenses
        .Where(e => e.Date.Date == _selectedDate.Date)
        .OrderByDescending(e => e.Date)
        .ToList();

        @if (!dailyTransactions.Any())
        {
            <p>No transactions recorded for this day.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var transaction in dailyTransactions)
                {
                    @if (transaction.Category == ExpenseCategory.Income)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-success">
                            <div>
                                <strong>@(_categoryDisplayInfo[transaction.Category].Icon) @transaction.Description</strong><br>
                                <small class="text-muted">Income - @transaction.Date.ToShortDateString()</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <button class="btn btn-sm btn-link p-0 me-2 edit-btn" @onclick="() => OpenEditModal(transaction)">✏️</button>
                                <span class="badge bg-success rounded-pill fs-6">+ ₴@Math.Abs(transaction.Amount).ToString("F2")</span>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@(_categoryDisplayInfo[transaction.Category].Icon) @transaction.Description</strong><br>
                                <small class="text-muted">@(_categoryDisplayInfo[transaction.Category].Name) - @transaction.Date.ToShortDateString()</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <button class="btn btn-sm btn-link p-0 me-2 edit-btn" @onclick="() => OpenEditModal(transaction)">✏️</button>
                                <span class="badge bg-secondary rounded-pill fs-6">₴@transaction.Amount.ToString("F2")</span>
                            </div>
                        </li>
                    }
                }
            </ul>
        }
    }


    @if (_showClearAllConfirmation)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal show" style="display:block;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Action</h5>
                        <button type="button" class="btn-close" @onclick="() => _showClearAllConfirmation = false"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete all transactions and reset your budget? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => _showClearAllConfirmation = false">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="HandleClearAllDataAsync">Yes, Clear Everything</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showEditModal)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal show" style="display:block;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Transaction</h5>
                        <button type="button" class="btn-close" @onclick="() => _showEditModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@_transactionToEdit" OnValidSubmit="HandleUpdateTransactionAsync">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Amount (₴)</label>
                                <InputNumber @bind-Value="_transactionToEdit.Amount" class="form-control form-control-lg" />
                                <ValidationMessage For="@(() => _transactionToEdit.Amount)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <InputText @bind-Value="_transactionToEdit.Description" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <InputSelect @bind-Value="_transactionToEdit.Category" class="form-select">
                                    @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                                    {
                                        <option value="@cat">@_categoryDisplayInfo[cat].Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                        </EditForm>
                    </div>
                    <div class="modal-footer justify-content-start">
                        <button type="button" class="btn btn-danger" @onclick="HandleDeleteTransactionAsync">Delete Transaction</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showAddExpenseModal)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal show" style="display:block;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add to @(_categoryDisplayInfo[_newExpense.Category].Name)</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@_newExpense" OnValidSubmit="HandleAddExpense">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Amount (₴)</label>
                                <InputNumber @bind-Value="_newExpense.Amount" class="form-control form-control-lg" />
                                <ValidationMessage For="@(() => _newExpense.Amount)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description (Optional)</label>
                                <InputText @bind-Value="_newExpense.Description" class="form-control" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Save Expense</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showAddIncomeModal)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal show" style="display:block;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Income</h5>
                        <button type="button" class="btn-close" @onclick="() => _showAddIncomeModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@_newIncome" OnValidSubmit="HandleAddIncome">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Income Amount (₴)</label>
                                <InputNumber @bind-Value="_newIncome.Amount" class="form-control form-control-lg" />
                                <ValidationMessage For="@(() => _newIncome.Amount)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description (e.g., "Salary", "Gift")</label>
                                <InputText @bind-Value="_newIncome.Description" class="form-control" />
                            </div>
                            <button type="submit" class="btn btn-success w-100">Add Income</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isEditingBudget)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal show" style="display:block;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Set Your Monthly Budget</h5>
                        <button type="button" class="btn-close" @onclick="() => _isEditingBudget = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group">
                            <span class="input-group-text">₴</span>
                            <input type="number" class="form-control" @bind="_budgetInput" />
                        </div>
                        <button class="btn btn-primary w-100 mt-3" @onclick="HandleSetBudget">Set Budget</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>